{
  "schemaVersion": 1,
  "id": "melonamin.flare",
  "name": "Flare",
  "version": "0.4.0",
  "author": "melonamin",
  "description": "Animated click highlights drawn over everything, for demos and screen recordings.",
  "homepage": "https://github.com/melonamin/omarchy-flare",
  "license": "MIT",
  "kinds": [
    "service",
    "panel",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
    "panel": "Flare.qml",
    "barWidget": "SettingsPanel.qml"
  },
  "barWidget": {
    "displayName": "Flare",
    "description": "Toggle click highlighting and tune its look",
    "category": "Utilities",
    "allowMultiple": false,
    "defaultSection": "right"
  }
}
